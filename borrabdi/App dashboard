    # =========================================================================
    # NAVIGATION, LIVE UPDATE API & THRESHOLD DEMO
    # =========================================================================
    def switch_section(self, section_name):
        self.current_section = section_name
        self.refresh_ui()

    def select_param(self, param_key):
        self.current_param = param_key
        self.refresh_ui()

    def step_slide(self, delta):
        if self.current_section != "ASTRONAUT HEALTH":
            return
        idx = HEALTH_PARAM_ORDER.index(self.current_param)
        self.current_param = HEALTH_PARAM_ORDER[(idx + delta) % len(HEALTH_PARAM_ORDER)]
        self.refresh_ui()

    def toggle_fullscreen(self, event=None):
        self.is_fullscreen = not self.is_fullscreen
        self.attributes("-fullscreen", self.is_fullscreen)

    def exit_fullscreen(self, event=None):
        self.is_fullscreen = False
        self.attributes("-fullscreen", False)

    def update_health_parameter(self, param_key, value):
        """Public API to push live biometric telemetry and auto-update cube colors."""
        if param_key in ASTRONAUT_HEALTH_DATA:
            ASTRONAUT_HEALTH_DATA[param_key]["value"] = str(value)
            self.refresh_ui()

    def update_radiation_environment(self, inside_msv, outside_msv):
        """Public API to push live inside/outside cabin radiation telemetry."""
        RADIATION_ENV_DATA["INSIDE"]["value"] = f"{float(inside_msv):.2f}"
        RADIATION_ENV_DATA["OUTSIDE"]["value"] = f"{float(outside_msv):.2f}"
        self.refresh_ui()

    def cycle_demo_thresholds(self, event=None):
        """Cycles sample physiological values to preview Green / Amber / Red cubes."""
        presets = [
            {  # All Nominal
                "Blood Sugar": "98",
                "Bone Density Reduction and Nephrolithiasis Risk": "-0.8",
                "Blood Pressure": "118/76",
                "Heart Rate": "62",
                "Body Temperature": "36.9",
                "Astronauts' Sleep": "7.2",
                "Astronauts' Mood": "88",
                "Personal Radiation Monitoring": "0.42",
            },
            {  # Mixed Advisory & Critical Alerts
                "Blood Sugar": "148",
                "Bone Density Reduction and Nephrolithiasis Risk": "-1.5",
                "Blood Pressure": "144/92",
                "Heart Rate": "114",
                "Body Temperature": "36.9",
                "Astronauts' Sleep": "4.6",
                "Astronauts' Mood": "68",
                "Personal Radiation Monitoring": "1.35",
            },
        ]
        self.demo_state_index = (self.demo_state_index + 1) % len(presets)
        for k, v in presets[self.demo_state_index].items():
            ASTRONAUT_HEALTH_DATA[k]["value"] = v
        self.refresh_ui()

    # =========================================================================
    # UI REFRESH
    # =========================================================================
    def refresh_ui(self):
        # Update Top Mode Tabs
        for sec, lbl in self.section_buttons.items():
            if sec == self.current_section:
                lbl.configure(bg="#38bdf8", fg="#090d16")
            else:
                lbl.configure(bg="#131c2e", fg="#94a3b8")

        if self.current_section == "ASTRONAUT HEALTH":
            self.radiation_view.grid_remove()
            self.left_col.grid(row=0, column=0, sticky="nsew", padx=(0, 7))
            self.health_slide.grid(row=0, column=1, sticky="nsew", padx=(7, 0))
            self._refresh_health_view()
        else:
            self.left_col.grid_remove()
            self.health_slide.grid_remove()
            self.radiation_view.grid(row=0, column=0, columnspan=2, sticky="nsew")
            self._refresh_radiation_view()

    def _refresh_health_view(self):
        # Update all 8 squares with automatic value-based colors
        for param_key, widgets in self.nav_cards.items():
            pdata = ASTRONAUT_HEALTH_DATA[param_key]
            status_lbl, accent, bg_idle, bg_active = self.evaluate_health_status(
                param_key, pdata["value"]
            )
            is_selected = param_key == self.current_param
            card_bg = bg_active if is_selected else bg_idle
            border_color = "#38bdf8" if is_selected else accent

            widgets["frame"].configure(bg=card_bg, highlightbackground=border_color)
            widgets["led"].configure(bg=accent)
            widgets["inner"].configure(bg=card_bg)
            widgets["name"].configure(
                bg=card_bg,
                fg="#f8fafc" if is_selected else "#cbd5e1",
            )
            widgets["value"].configure(
                bg=card_bg,
                fg=accent,
                text=f"{pdata['value']} {pdata['unit']}",
            )

        # Update Active Right-Hand Slide
        active = ASTRONAUT_HEALTH_DATA[self.current_param]
        status_lbl, accent, _, _ = self.evaluate_health_status(
            self.current_param, active["value"]
        )
        idx = HEALTH_PARAM_ORDER.index(self.current_param) + 1

        self.lbl_slide_counter.configure(text=f"PARAMETER {idx} / {len(HEALTH_PARAM_ORDER)}  (↑ ↓)")
        self.hero_box.configure(highlightbackground=accent)
        self.lbl_status_badge.configure(text=f"● {status_lbl}", fg=accent)
        self.lbl_hero_title.configure(text=active["hero_title"])
        self.lbl_hero_value.configure(text=active["value"], fg=accent)
        self.lbl_hero_unit.configure(text=f" {active['unit']}")
        self.lbl_range_hint.configure(text=active["range_hint"])

        self.lbl_protocol_steps.configure(text="\n\n".join(active["protocol"]))
        self.lbl_recommendations.configure(
            text="\n\n".join(f"•  {item}" for item in active["recommendations"])
        )

    def _refresh_radiation_view(self):
        in_val = float(RADIATION_ENV_DATA["INSIDE"]["value"])
        out_val = float(RADIATION_ENV_DATA["OUTSIDE"]["value"])
        attenuation = max(0.0, (1.0 - (in_val / out_val)) * 100.0) if out_val > 0 else 0.0
        self.lbl_attenuation.configure(
            text=f"HULL SHIELDING ATTENUATION: {attenuation:.1f}%"
        )

        for zone, widgets in self.rad_panels.items():
            zdata = RADIATION_ENV_DATA[zone]
            status_lbl, accent, _ = self.evaluate_radiation_status(zdata["value"])

            widgets["panel"].configure(highlightbackground=accent)
            widgets["badge"].configure(text=f"{zdata['badge']}  •  {status_lbl}", fg=accent)
            widgets["title"].configure(text=zdata["title"])
            widgets["value"].configure(text=zdata["value"], fg=accent)
            widgets["unit"].configure(text=f" {zdata['unit']}")
            widgets["meta"].configure(
                text=f"Cumulative Mission Dose: {zdata['cumulative']}   |   Spectrum: {zdata['composition']}"
            )
            widgets["protocol"].configure(text="\n".join(zdata["protocol"]))
            widgets["recommendations"].configure(
                text="\n".join(f"•  {r}" for r in zdata["recommendations"])
            )


