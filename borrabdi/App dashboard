    # =========================================================================
    # AUTOMATIC COLOR & STATUS ENGINE (Changes cube color based on value)
    # =========================================================================
    def evaluate_health_status(self, param_key, raw_value):
        """
        Evaluates numeric parameter value and returns:
        (status_label, accent_color, card_bg_idle, card_bg_active)
        """
        NOMINAL = ("NOMINAL", "#22c55e", "#101e1b", "#152e27")
        WARNING = ("ADVISORY", "#f59e0b", "#241c11", "#362814")
        CRITICAL = ("CRITICAL", "#ef4444", "#261216", "#3b171e")

        try:
            if param_key == "Blood Pressure":
                parts = str(raw_value).split("/")
                sys_val = float(parts[0])
                dia_val = float(parts[1])
                if sys_val >= 140 or dia_val >= 90 or sys_val < 85:
                    return CRITICAL
                if (130 <= sys_val <= 139) or (85 <= dia_val <= 89) or (85 <= sys_val < 90):
                    return WARNING
                return NOMINAL

            val = float(raw_value)

            if param_key == "Blood Sugar":
                if val < 60 or val > 180:
                    return CRITICAL
                if val < 70 or val > 130:
                    return WARNING
                return NOMINAL

            if param_key == "Bone Density Reduction and Nephrolithiasis Risk":
                if val < -2.0:
                    return CRITICAL
                if val < -1.0:
                    return WARNING
                return NOMINAL

            if param_key == "Heart Rate":
                if val < 42 or val > 130:
                    return CRITICAL
                if val < 50 or val > 100:
                    return WARNING
                return NOMINAL

            if param_key == "Body Temperature":
                if val < 35.5 or val > 38.2:
                    return CRITICAL
                if val < 36.1 or val > 37.5:
                    return WARNING
                return NOMINAL

            if param_key == "Astronauts' Sleep":
                if val < 5.0:
                    return CRITICAL
                if val < 6.5:
                    return WARNING
                return NOMINAL

            if param_key == "Astronauts' Mood":
                if val < 55:
                    return CRITICAL
                if val < 75:
                    return WARNING
                return NOMINAL

            if param_key == "Personal Radiation Monitoring":
                if val > 1.20:
                    return CRITICAL
                if val > 0.60:
                    return WARNING
                return NOMINAL

        except (ValueError, IndexError):
            return WARNING

        return NOMINAL

    def evaluate_radiation_status(self, msv_value):
        val = float(msv_value)
        if val > 1.20:
            return ("ELEVATED FLUX", "#ef4444", "#261216")
        if val > 0.60:
            return ("MODERATE FLUX", "#f59e0b", "#241c11")
        return ("NOMINAL SHIELDED", "#22c55e", "#101e1b")

